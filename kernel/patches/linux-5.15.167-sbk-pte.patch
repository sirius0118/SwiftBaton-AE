+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_SWIFTBATON_PTE_H
+#define _LINUX_SWIFTBATON_PTE_H
+#include <linux/mm.h>
+#include <linux/module.h>
+
+/* Built-in MM bridge; providers remain modules. Never encode a kernel pointer. */
+#define SBK_PTE_DEMAND 0
+#define SBK_PTE_PREFETCH 1
+#define SBK_PTE_BACKGROUND 2
+struct sbk_pte_provider {
+	struct module *owner;
+	/* Return an exclusive, unmapped order-0 page reference, with DMA finished.
+	 * The MM bridge charges it and adopts it as a normal anonymous page.
+	 * Source/prefetch cache pages may be handed off, never shared writable.
+	 */
+	struct page *(*get_page)(void *cookie, struct vm_area_struct *vma,
+				 unsigned long address, unsigned int lane, bool user_fault);
+	void (*installed)(void *cookie, struct mm_struct *mm,
+			  unsigned long address, unsigned int lane, bool user_fault);
+	/* USER faults: entry to this bridge through PTE install/prefetch scheduling.
+	 * Does not include x86 fault entry or the eventual return to userspace. */
+	void (*fault_done)(void *cookie, u64 elapsed_ns, vm_fault_t result);
+	/* Non-sleeping: last marker can disappear under a page-table spinlock. */
+	void (*release)(void *cookie);
+};
+
+#ifdef CONFIG_SWIFTBATON_PTE
+int sbk_pte_token_create(const struct sbk_pte_provider *ops, void *cookie,
+			unsigned long *id);
+bool sbk_pte_token_get(unsigned long id);
+void sbk_pte_token_put(unsigned long id);
+int sbk_pte_arm(struct mm_struct *mm, unsigned long start, unsigned long count,
+		const unsigned long *ids);
+int sbk_pte_populate(struct mm_struct *mm, unsigned long address,
+		     unsigned long expected_id, unsigned int lane);
+int sbk_pte_populate_all(unsigned long expected_id, unsigned int lane);
+vm_fault_t sbk_pte_fault(struct vm_fault *vmf, unsigned int lane);
+#else
+static inline bool sbk_pte_token_get(unsigned long id) { return false; }
+static inline void sbk_pte_token_put(unsigned long id) { }
+static inline vm_fault_t sbk_pte_fault(struct vm_fault *vmf, unsigned int lane)
+{
+	return VM_FAULT_SIGBUS;
+}
+#endif
+#endif
